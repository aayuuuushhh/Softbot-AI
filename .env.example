# --- Secrets ---
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# --- Database ---
UDDHAR_MONGODB_URI=mongodb://localhost:27017
UDDHAR_MONGODB_DB=uddhar

# --- Perception backends: stub | torch ---
# `stub`  = deterministic OpenCV pipeline, needs no weights
# `torch` = PyTorch nets; falls back to stub (with a warning) if the .pt is missing
UDDHAR_SAT_BACKEND=stub
UDDHAR_GROUND_BACKEND=stub

# --- Compute ---
UDDHAR_DEVICE=cuda
UDDHAR_TILE_SIZE=512
UDDHAR_TILE_OVERLAP=64
UDDHAR_BATCH_SIZE=4

# --- Agent ---
UDDHAR_LLM_MODEL=claude-opus-5
UDDHAR_RESEARCH_CACHE_TTL_HOURS=168

# --- API ---
UDDHAR_CORS_ORIGINS=http://localhost:3000
