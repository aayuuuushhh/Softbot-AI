# Gemini powers the situation brief, per-zone risk analysis and the resource
# allocation plan. Supply one key, or several comma-separated: the narrator
# falls through to the next key when one is rate limited or rejected.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order once every key is out of quota on GEMINI_MODEL. The free
# tier counts requests per model per day (20 on gemini-3.6-flash), so
# without these the brief drops to the deterministic stub for the rest of
# the day even though the same keys still answer on another model.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
BACKEND_URL=http://localhost:8000
# Relative paths resolve against the repo root, never the working directory, so
# this stays correct whether uvicorn starts from the repo root or from backend/.
# The Docker image and compose override it with an absolute /app/data/demo.
DEMO_DATA_DIR=data/demo
# stub    — no model needed. Uses the xBD ground-truth target when a demo pair
#           ships one, otherwise a co-registered, illumination-corrected pre/post
#           change-detection heuristic (a proxy for real inference, not a model).
# docker  — requires the xView2 baseline image built and the Docker daemon up.
# pytorch — real fine-tuned model; the only mode reporting per-zone confidence.
#           Needs BOTH a trained checkpoint at PYTORCH_CHECKPOINT_PATH and the
#           xView2 model repo cloned into ml/pytorch-xview2 (see ml/README.md).
INFERENCE_MODE=stub
XVIEW2_DOCKER_IMAGE=darknem-xview2-inference
# Only read when INFERENCE_MODE=pytorch. Relative to the repo root.
PYTORCH_CHECKPOINT_PATH=ml/checkpoints/damage_best.ckpt

# CORS: production Vercel origin is included in backend defaults. Override with a
# JSON list if the frontend URL changes:
# CORS_ORIGINS=["https://disasteriq.vercel.app","http://localhost:3000","http://127.0.0.1:3000"]
# Opt-in only — allows ANY matching host to call the API. Prefer exact CORS_ORIGINS.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Endpoint protection (both opt-in).
# ACCESS_TOKEN: if set, /analyze, /brief, /report/pdf and /analyze-and-brief
#   require an X-API-Key header matching this value. Leave empty for open access
#   (a browser-only frontend cannot hold a secret, so only enable this behind a
#   server-side proxy or for non-browser clients).
ACCESS_TOKEN=
# Per-IP sliding-window rate limit. Set RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Hide /docs and /redoc on public deployments.
DISABLE_OPENAPI_DOCS=false
